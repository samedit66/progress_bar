# VHS records PNG frames; ffmpeg turns them into the committed GIF.
Output demo-frames/

Set Shell "bash"
Set FontFamily "Menlo"
Set FontSize 18
Set Width 1000
Set Height 700
Set Padding 20
Set WindowBar "Colorful"
Set WindowBarSize 32
Set Theme "Catppuccin Mocha"
Set Framerate 30
Set TypingSpeed 0ms

Type "cd /Users/smd66/Projects/progress_bar" Enter
Sleep 200ms
Type "./progress_bar_demo" Enter
Sleep 15s

Output demo-frames/

Set Shell "bash"
Set FontFamily "Menlo"
Set FontSize 18
Set LetterSpacing 0
Set LineHeight 1.0
Set Width 1000
Set Height 700
Set Padding 20
Set WindowBar "Colorful"
Set WindowBarSize 32
Set Theme "Catppuccin Mocha"
Set Framerate 30
Set TypingSpeed 0ms

Type "./progress_bar_demo" Enter
Sleep 28s
